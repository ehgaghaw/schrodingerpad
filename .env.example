# Copy to .env for local development. Never commit .env or any private key.

# Postgres connection string (Railway: reference the Postgres service's DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# true = devnet with fake pump.fun launches, buys, fees and holders (commitment memos stay real on devnet)
TEST_MODE=true

# Helius API key: RPC, holder lists (DAS getTokenAccounts) and the webhook. Optional in TEST_MODE.
HELIUS_API_KEY=
# Shared secret Helius sends in the Authorization header of the raw webhook to /api/webhooks/helius
HELIUS_WEBHOOK_SECRET=
# Optional explicit RPC URL (overrides Helius / public)
SOLANA_RPC_URL=

# Launcher wallet secret key, base58 or JSON byte array. Creates coins, writes commitment memos,
# collects creator fees, pays out and buys back. Keep it funded. Never commit it.
LAUNCHER_PRIVATE_KEY=

# ANU quantum random numbers API key (api.quantumnumbers.anu.edu.au). Without it the free ANU endpoint is
# used; if that fails too, the box uses the classical fallback and is labelled so on the site.
QRNG_API_KEY=

# Fate mechanics
CREATOR_FEE_SHARE_PERCENT=20
DECOHERENCE_MINUTES=10
ALIVE_ODDS_PERCENT=50
FEE_CYCLE_MINUTES=10
MIN_PAYOUT_SOL=0.0005
MIN_BUYBACK_SOL=0.01

# Launches
LAUNCH_COST_SOL=0.05
DEV_BUY_SOL=0

# Admin (/admin). Admin is disabled when ADMIN_PASSWORD is empty.
ADMIN_PASSWORD=
SESSION_SECRET=

# Public site URL, used in X posts and coin metadata
PUBLIC_URL=

# X auto-posting of collapses (optional)
X_POSTING=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_HANDLE=SchrodingerPad
GITHUB_URL=https://github.com/ehgaghaw/schrodingerpad

# Railway: set SERVICE_ROLE=worker on the worker service; leave unset on the web service
SERVICE_ROLE=
